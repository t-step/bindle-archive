#!/usr/bin/env bash
#
# claude-kit post-merge hook. After a `git pull`/merge, link any newly added
# items into ~/.claude/ automatically. Edits to existing items are already live
# through their symlinks; this just picks up brand-new skills/agents/commands.
# Non-destructive: it never prunes (use `bin/install.sh --prune` for that).
#
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/bin/install.sh"
